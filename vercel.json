{
  "rewrites": [
    { "source": "/test/:id", "destination": "/test/index.html" }
  ],
  "redirects": [
    { "source": "/curriculum", "destination": "/assistant-editing/", "permanent": true },
    { "source": "/curriculum/", "destination": "/assistant-editing/", "permanent": true },
    { "source": "/curriculum/:path*", "destination": "/assistant-editing/:path*", "permanent": true },
    { "source": "/training", "destination": "/videos/#training", "permanent": true },
    { "source": "/training/", "destination": "/videos/#training", "permanent": true },
    { "source": "/training/:path*", "destination": "/videos/#training", "permanent": true }
  ]
}
